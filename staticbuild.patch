diff --git a/configure b/configure
index b6f90bcd8c..86560e3d41 100755
--- a/configure
+++ b/configure
@@ -818,6 +818,7 @@ MODULE_TIME_TRUE
 MODULE__IO_FALSE
 MODULE__IO_TRUE
 MODULE_BUILDTYPE
+XXLIMITED_MODULES
 TEST_MODULES
 LIBB2_LIBS
 LIBB2_CFLAGS
@@ -1117,6 +1118,7 @@ with_openssl_rpath
 with_ssl_default_suites
 with_builtin_hashlib_hashes
 enable_test_modules
+enable_xxlimited_modules
 '
       ac_precious_vars='build_alias
 host_alias
@@ -1821,6 +1823,8 @@ Optional Features:
                           use big digits (30 or 15 bits) for Python longs
                           (default is 30)]
   --disable-test-modules  don't build nor install test modules
+  --disable-xxlimited-modules
+                          don't build nor install xxlimited modules
 
 Optional Packages:
   --with-PACKAGE[=ARG]    use PACKAGE [ARG=yes]
@@ -28500,6 +28504,29 @@ printf "%s\n" "$TEST_MODULES" >&6; }
 
 
 
+# Check whether to disable xxlimited modules. Once set, setup.py will not build
+# test extension modules and "make install" will not install them.
+{ printf "%s\n" "$as_me:${as_lineno-$LINENO}: checking for --disable-xxlimited-modules" >&5
+printf %s "checking for --disable-xxlimited-modules... " >&6; }
+# Check whether --enable-xxlimited-modules was given.
+if test ${enable_xxlimited_modules+y}
+then :
+  enableval=$enable_xxlimited_modules;
+  if test "x$enable_xxlimited_modules" = xyes
+then :
+  XXLIMITED_MODULES=yes
+else $as_nop
+  XXLIMITED_MODULES=no
+fi
+
+else $as_nop
+  XXLIMITED_MODULES=yes
+fi
+
+{ printf "%s\n" "$as_me:${as_lineno-$LINENO}: result: $XXLIMITED_MODULES" >&5
+printf "%s\n" "$XXLIMITED_MODULES" >&6; }
+
+
 # stdlib not available
 case $ac_sys_system in #(
   AIX) :
@@ -31157,7 +31184,7 @@ printf %s "checking for stdlib extension module xxlimited... " >&6; }
         if test "$py_cv_module_xxlimited" != "n/a"
 then :
 
-    if test "$with_trace_refs" = "no"
+    if test "$with_trace_refs" = "no" && test "$XXLIMITED_MODULES" = yes
 then :
   if test "$ac_cv_func_dlopen" = yes
 then :
@@ -31195,7 +31222,7 @@ printf %s "checking for stdlib extension module xxlimited_35... " >&6; }
         if test "$py_cv_module_xxlimited_35" != "n/a"
 then :
 
-    if test "$with_trace_refs" = "no"
+    if test "$with_trace_refs" = "no" && test "$XXLIMITED_MODULES" = yes
 then :
   if test "$ac_cv_func_dlopen" = yes
 then :
diff --git a/configure.ac b/configure.ac
index ba768aea93..74dc565d1c 100644
--- a/configure.ac
+++ b/configure.ac
@@ -7200,6 +7200,16 @@ AC_DEFUN([PY_STDLIB_MOD_SET_NA], [
     AS_VAR_SET([py_cv_module_]mod, [n/a])])
 ])
 
+# Check whether to disable xxlimited modules. Once set, setup.py will not build
+# test extension modules and "make install" will not install them.
+AC_MSG_CHECKING([for --disable-xxlimited-modules])
+AC_ARG_ENABLE([xxlimited-modules],
+  [AS_HELP_STRING([--disable-xxlimited-modules], [don't build nor install xxlimited modules])], [
+  AS_VAR_IF([enable_xxlimited_modules], [yes], [XXLIMITED_MODULES=yes], [XXLIMITED_MODULES=no])
+], [XXLIMITED_MODULES=yes])
+AC_MSG_RESULT([$XXLIMITED_MODULES])
+AC_SUBST([XXLIMITED_MODULES])
+
 # stdlib not available
 dnl Modules that are not available on some platforms
 dnl AIX has shadow passwords, but access is not via getspent()
@@ -7492,8 +7502,8 @@ PY_STDLIB_MOD([_ctypes_test],
 dnl Limited API template modules.
 dnl The limited C API is not compatible with the Py_TRACE_REFS macro.
 dnl Emscripten does not support shared libraries yet.
-PY_STDLIB_MOD([xxlimited], [test "$with_trace_refs" = "no"], [test "$ac_cv_func_dlopen" = yes])
-PY_STDLIB_MOD([xxlimited_35], [test "$with_trace_refs" = "no"], [test "$ac_cv_func_dlopen" = yes])
+PY_STDLIB_MOD([xxlimited], [test "$with_trace_refs" = "no" && test "$XXLIMITED_MODULES" = yes], [test "$ac_cv_func_dlopen" = yes])
+PY_STDLIB_MOD([xxlimited_35], [test "$with_trace_refs" = "no" && test "$XXLIMITED_MODULES" = yes], [test "$ac_cv_func_dlopen" = yes])
 
 # substitute multiline block, must come after last PY_STDLIB_MOD()
 AC_SUBST([MODULE_BLOCK])
